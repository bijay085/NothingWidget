<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <!-- Package visibility for Weather tap targets + Screen Time app labels (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_WEATHER" />
        </intent>
        <package android:name="com.google.android.apps.weather" />
        <package android:name="com.sec.android.daemonapp" />
        <package android:name="com.huawei.android.totemweather" />
        <package android:name="com.miui.weather2" />
        <package android:name="net.oneplus.weather" />
        <package android:name="com.nothing.weather" />
        <package android:name="com.accuweather.android" />
        <package android:name="com.weather.Weather" />
        <package android:name="com.yahoo.mobile.client.android.weather" />
        <package android:name="com.google.android.apps.wellbeing" />
        <intent>
            <action android:name="com.google.android.apps.wellbeing.action.APP_USAGE_DASHBOARD" />
        </intent>
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.forest" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.phonemanager" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.nothing.hearthstone" />
        <!-- Quick Actions: camera / QR scanner targets -->
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google" android:host="lens" />
        </intent>
        <package android:name="com.google.zxing.client.android" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_CALENDAR" />
        </intent>
        <package android:name="com.google.android.keep" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingWidget">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NothingWidget"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AppWidget configure screens (launcher must be able to start them). -->
        <activity
            android:name="com.phoenix.nothingwidget.widgets.round_clock.RoundClockConfigActivity"
            android:exported="true"
            android:label="@string/widget_customization_label"
            android:theme="@style/Theme.NothingWidget"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.phoenix.nothingwidget.widgets.weather.WeatherConfigActivity"
            android:exported="true"
            android:label="@string/widget_customization_label"
            android:theme="@style/Theme.NothingWidget"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.phoenix.nothingwidget.widgets.screen_time.ScreenTimeConfigActivity"
            android:exported="true"
            android:label="@string/widget_customization_label"
            android:theme="@style/Theme.NothingWidget"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.phoenix.nothingwidget.widgets.screen_time_large.ScreenTimeLargeConfigActivity"
            android:exported="true"
            android:label="@string/widget_customization_label"
            android:theme="@style/Theme.NothingWidget"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.phoenix.nothingwidget.widgets.quick_actions.QuickActionsPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="com.phoenix.nothingwidget.widgets.quick_actions.QuickActionsConfigActivity"
            android:exported="true"
            android:label="@string/widget_customization_label"
            android:theme="@style/Theme.NothingWidget"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Exported only for system AppWidget / alarm broadcasts; internal refresh uses explicit intents. -->
        <receiver
            android:name="com.phoenix.nothingwidget.widgets.round_clock.RoundClockWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_round_clock_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_round_clock_info" />
        </receiver>

        <receiver
            android:name="com.phoenix.nothingwidget.widgets.weather.WeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_weather_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver
            android:name="com.phoenix.nothingwidget.widgets.screen_time.ScreenTimeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_screen_time_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_screen_time_info" />
        </receiver>

        <receiver
            android:name="com.phoenix.nothingwidget.widgets.screen_time_large.ScreenTimeLargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_screen_time_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_screen_time_large_info" />
        </receiver>

        <receiver
            android:name="com.phoenix.nothingwidget.widgets.quick_actions.QuickActionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_actions_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>
    </application>

</manifest>
