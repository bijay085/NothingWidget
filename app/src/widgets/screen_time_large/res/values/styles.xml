<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ScreenTimeLargeTotal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">@string/widget_screen_time_large_mock_total</item>
        <item name="android:textColor">@color/screen_time_large_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ScreenTimeLargeTotal.Clean">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="ScreenTimeLargeTotal.Digital">
        <item name="android:fontFamily">Lettera</item>
    </style>
    <style name="ScreenTimeLargeTotal.Futuristic">
        <item name="android:fontFamily">@font/futuristic</item>
    </style>
    <style name="ScreenTimeLargeTotal.PixelMono">
        <item name="android:fontFamily">@font/pixel_mono</item>
    </style>
    <style name="ScreenTimeLargeTotal.DarkSpooky">
        <item name="android:fontFamily">@font/dark_spooky</item>
    </style>

    <style name="ScreenTimeLargeLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
