<?xml version="1.0" encoding="utf-8"?>
<!-- Host: content + nav packed at top (no gap between list and ◀ ▶). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_screen_time_large_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_time_large_background"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ViewFlipper
        android:id="@+id/screen_time_large_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoStart="false"
        android:measureAllChildren="false">

        <include
            layout="@layout/widget_screen_time_large_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            layout="@layout/widget_screen_time_large_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ViewFlipper>

    <LinearLayout
        android:id="@+id/screen_time_large_indicator"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/screen_time_large_btn_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/screen_time_large_cd_prev"
            android:scaleType="center"
            android:src="@drawable/screen_time_large_ic_left" />

        <ImageView
            android:id="@+id/screen_time_large_dot_today"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/screen_time_large_dot_on" />

        <ImageView
            android:id="@+id/screen_time_large_dot_privacy"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/screen_time_large_dot_off" />

        <ImageView
            android:id="@+id/screen_time_large_btn_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/screen_time_large_cd_next"
            android:scaleType="center"
            android:src="@drawable/screen_time_large_ic_right" />
    </LinearLayout>
</LinearLayout>
