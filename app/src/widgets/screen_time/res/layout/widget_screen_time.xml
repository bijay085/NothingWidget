<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_screen_time_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_time_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/screen_time_label"
                style="@style/ScreenTimeLabel.Clean" />

            <TextView
                android:id="@+id/screen_time_label_digital"
                style="@style/ScreenTimeLabel.Digital"
                android:visibility="gone" />

            <TextView
                android:id="@+id/screen_time_label_futuristic"
                style="@style/ScreenTimeLabel.Futuristic"
                android:visibility="gone" />

            <TextView
                android:id="@+id/screen_time_label_pixel"
                style="@style/ScreenTimeLabel.PixelMono"
                android:visibility="gone" />

            <TextView
                android:id="@+id/screen_time_label_spooky"
                style="@style/ScreenTimeLabel.DarkSpooky"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/screen_time_indicator_ring"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/screen_time_indicator_ring"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/screen_time_indicator_bar"
            android:layout_width="40dp"
            android:layout_height="6dp"
            android:contentDescription="@null"
            android:src="@drawable/screen_time_indicator_bar"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/screen_time_total"
            style="@style/ScreenTimeTotal.Clean" />

        <TextView
            android:id="@+id/screen_time_total_digital"
            style="@style/ScreenTimeTotal.Digital"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_time_total_futuristic"
            style="@style/ScreenTimeTotal.Futuristic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_time_total_pixel"
            style="@style/ScreenTimeTotal.PixelMono"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_time_total_spooky"
            style="@style/ScreenTimeTotal.DarkSpooky"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="0dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/screen_time_top_app"
            style="@style/ScreenTimeApp.Clean" />

        <TextView
            android:id="@+id/screen_time_top_app_digital"
            style="@style/ScreenTimeApp.Digital"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_time_top_app_futuristic"
            style="@style/ScreenTimeApp.Futuristic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_time_top_app_pixel"
            style="@style/ScreenTimeApp.PixelMono"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screen_time_top_app_spooky"
            style="@style/ScreenTimeApp.DarkSpooky"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/screen_time_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_screen_time_mock_date"
        android:textColor="@color/screen_time_secondary"
        android:textSize="12sp" />
</LinearLayout>
