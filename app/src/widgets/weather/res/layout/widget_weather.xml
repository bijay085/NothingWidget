<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews-safe. Weather-first hierarchy: not a clock variant. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_weather_click_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/widget_weather_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/weather_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/weather_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="0dp"
            android:contentDescription="@string/widget_weather_icon_description"
            android:scaleType="fitCenter"
            android:src="@drawable/weather_ic_cloud" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="4dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/weather_temperature"
                    style="@style/WeatherTemperature" />

                <TextView
                    android:id="@+id/weather_temperature_clean"
                    style="@style/WeatherTemperature.Clean"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_temperature_digital"
                    style="@style/WeatherTemperature.Digital"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_temperature_futuristic"
                    style="@style/WeatherTemperature.Futuristic"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_temperature_pixel"
                    style="@style/WeatherTemperature.PixelMono"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="5dp">

                <TextView
                    android:id="@+id/weather_unit"
                    style="@style/WeatherSecondaryText"
                    android:text="@string/widget_weather_mock_unit"
                    android:textAllCaps="true"
                    android:textSize="@dimen/weather_text_unit" />

                <TextView
                    android:id="@+id/weather_unit_clean"
                    style="@style/WeatherSecondaryText.Clean"
                    android:text="@string/widget_weather_mock_unit"
                    android:textAllCaps="true"
                    android:textSize="@dimen/weather_text_unit"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_unit_digital"
                    style="@style/WeatherSecondaryText.Digital"
                    android:text="@string/widget_weather_mock_unit"
                    android:textAllCaps="true"
                    android:textSize="@dimen/weather_text_unit"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/weather_unit_futuristic"
                    style="@style/WeatherSecondaryText.Futuristic"
                    android:text="@string/widget_weather_mock_unit"
                    android:textAllCaps="true"
                    android:textSize="@dimen/weather_text_unit"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/weather_condition"
                style="@style/WeatherSecondaryText"
                android:gravity="start"
                android:text="@string/widget_weather_mock_condition"
                android:textAlignment="viewStart"
                android:textSize="@dimen/weather_text_condition" />

            <TextView
                android:id="@+id/weather_condition_clean"
                style="@style/WeatherSecondaryText.Clean"
                android:gravity="start"
                android:text="@string/widget_weather_mock_condition"
                android:textAlignment="viewStart"
                android:textSize="@dimen/weather_text_condition"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weather_condition_digital"
                style="@style/WeatherSecondaryText.Digital"
                android:gravity="start"
                android:text="@string/widget_weather_mock_condition"
                android:textAlignment="viewStart"
                android:textSize="@dimen/weather_text_condition"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weather_condition_futuristic"
                style="@style/WeatherSecondaryText.Futuristic"
                android:gravity="start"
                android:text="@string/widget_weather_mock_condition"
                android:textAlignment="viewStart"
                android:textSize="@dimen/weather_text_condition"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weather_condition_spooky"
                style="@style/WeatherSecondaryText.DarkSpooky"
                android:gravity="start"
                android:text="@string/widget_weather_mock_condition"
                android:textAlignment="viewStart"
                android:textSize="@dimen/weather_text_condition"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="0dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/weather_location"
                style="@style/WeatherSecondaryText"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/widget_weather_location_unavailable"
                android:textAlignment="viewStart"
                android:textColor="@color/weather_text_muted"
                android:textSize="@dimen/weather_text_location" />

            <TextView
                android:id="@+id/weather_location_clean"
                style="@style/WeatherSecondaryText.Clean"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/widget_weather_location_unavailable"
                android:textAlignment="viewStart"
                android:textColor="@color/weather_text_muted"
                android:textSize="@dimen/weather_text_location"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weather_location_digital"
                style="@style/WeatherSecondaryText.Digital"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/widget_weather_location_unavailable"
                android:textAlignment="viewStart"
                android:textColor="@color/weather_text_muted"
                android:textSize="@dimen/weather_text_location"
                android:visibility="gone" />

            <TextView
                android:id="@+id/weather_location_spooky"
                style="@style/WeatherSecondaryText.DarkSpooky"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/widget_weather_location_unavailable"
                android:textAlignment="viewStart"
                android:textColor="@color/weather_text_muted"
                android:textSize="@dimen/weather_text_location"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
