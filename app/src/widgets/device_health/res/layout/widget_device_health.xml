<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 host: 4 pages, button/dot navigation only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_device_health_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/device_health_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <ViewFlipper
        android:id="@+id/device_health_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoStart="false"
        android:measureAllChildren="false">

        <include
            layout="@layout/widget_device_health_overview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/widget_device_health_charging"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/widget_device_health_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/widget_device_health_performance"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </ViewFlipper>

    <LinearLayout
        android:id="@+id/device_health_indicator"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/device_health_btn_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/device_health_cd_prev"
            android:scaleType="center"
            android:src="@drawable/device_health_ic_left" />

        <ImageView
            android:id="@+id/device_health_dot_0"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/device_health_dot_on" />

        <ImageView
            android:id="@+id/device_health_dot_1"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/device_health_dot_off" />

        <ImageView
            android:id="@+id/device_health_dot_2"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/device_health_dot_off" />

        <ImageView
            android:id="@+id/device_health_dot_3"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="center"
            android:src="@drawable/device_health_dot_off" />

        <ImageView
            android:id="@+id/device_health_btn_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="@string/device_health_cd_next"
            android:scaleType="center"
            android:src="@drawable/device_health_ic_right" />
    </LinearLayout>
</LinearLayout>
